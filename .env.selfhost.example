# AethOS self-host — minimal config. Copy to `.env` and fill the two required lines.
#   cp .env.selfhost.example .env

# ── Required ─────────────────────────────────────────────────────────────────

# Single-user mode: no multi-tenant beta gate, no auth wall, you own your instance.
SELF_HOST=true

# Encrypts the credential vault on disk. Generate one and keep it safe — losing it
# means re-entering provider keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AETHOS_VAULT_KEY=

# At least one model provider. Pick ONE of the following blocks.

# Option A — Anthropic (Claude) directly:
USE_REAL_LLM=true
ACTIVE_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Option B — OpenRouter (one key → many models). Uncomment and use instead of A:
# USE_REAL_LLM=true
# ACTIVE_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Web/research search (Brave, Tavily, etc.) — enables the Research panel.
# WEB_RESEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_API_KEY=

# Messaging channels — connect from the UI (Settings → Channels) instead of here,
# or set tokens directly. WhatsApp example (Meta Cloud API):
# WHATSAPP_ENABLED=true
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# Browser automation (governed) — on by default in the image; turn off to save RAM:
# BROWSER_AUTOMATION_ENABLED=false
