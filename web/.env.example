# Mission Control API (local default). For a hosted deployment point this at
# your public API URL, e.g. NEXT_PUBLIC_API_BASE=https://your-domain.example/aethos-api
# Leave unset in local dev — UI proxies /api/v1 to :8010 so auth cookies work on localhost:3000.
# NEXT_PUBLIC_API_BASE=http://localhost:8010
