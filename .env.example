# AethOS environment template — copy to .env and fill in values.
# cp .env.example .env
# Never commit real secrets. .env is gitignored.

# --- App / API ---
APP_ENV=development
API_PORT=8010

# --- Batteries included (safe BYOK defaults) ---
# When true (default), safe user-funded capabilities are ON without extra toggles:
# chat streaming, agent runtime, workspace suite, canvas, vector memory, model foundry,
# arbiter, model failover, orchestration board delegate, MCP bridge.
# Owner-cost / dangerous surfaces stay OFF: channels, voice, web_research (needs user's
# search key in Connections), browser automation, host executor, mutation/autonomous gates.
# Set false for a minimal operator deployment.
AETHOS_BATTERIES_INCLUDED=true

# --- AI model providers ---
# USE_REAL_LLM=true + at least one provider key below enables full reasoning and
# provider-backed jobs. Set ACTIVE_PROVIDER to the provider you want to drive the
# main loop; every configured provider also appears in the in-app model picker,
# the multi-model arbiter pool, and the failover chain.
# One OpenRouter key alone unlocks a multi-provider model catalog.
USE_REAL_LLM=false
ACTIVE_PROVIDER=anthropic

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenRouter (one key, many models) — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# xAI (Grok) — https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Together AI — https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Local / self-hosted (Ollama, LM Studio, any OpenAI-compatible server).
# Example: LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODELS=
# AethOS agent LLM tool loop for open chat (step 3). Requires USE_REAL_LLM=true.
# Default on when AETHOS_BATTERIES_INCLUDED=true (BYOK — user's model key).
AGENT_RUNTIME_ENABLED=true
AGENT_CONTEXT_COMPACTION_ENABLED=true
AGENT_TOOL_LOOP_DETECTION_ENABLED=true
# Run multi-agent coordination as a durable server-side job so the run survives
# navigation / tab close; the UI reattaches by job_id. Default on.
DURABLE_AGENT_JOBS_ENABLED=true
# §1 Prompt caching (Anthropic ephemeral cache_control) — caches the stable
# system prompt + tool catalog so repeat turns re-read it cheaply. retention:
# short = 5m TTL; long = 1h TTL (extended-cache beta header).
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_RETENTION=short
# §2 Chat streaming — stream the governed reply incrementally over SSE
# (token-by-token render + abort). Default on with batteries included.
CHAT_STREAMING_ENABLED=true
# §1 Live progress narration — emit human-readable step/thought events from the
# agent tool loop ("Listing your Railway projects… ✓ Found …") so the operator
# sees what AethOS is doing as it happens. Read-only visibility (never executes
# anything, never bypasses approval). Default on; set false for exactly today's
# behavior (no events emitted).
LIVE_PROGRESS_ENABLED=true
# §9 Model failover — on rate-limit / 5xx / timeout, retry the next model in the
# chain (comma-separated, highest priority first). The usage strip shows the
# model that actually answered. Tokens still come from the Mission Control vault.
MODEL_FAILOVER_ENABLED=true
MODEL_FAILOVER_CHAIN=
# §7 Orchestration board "delegate task" — spawn an on-demand agent from Mission
# Control (runs read-only coordination). Default off; the board visualization
# works without it.
ORCHESTRATION_BOARD_DELEGATE_ENABLED=true

# Supabase (optional — solo-execution workspace env resolution for your own app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Account-wide Supabase Management API Personal Access Token (one token, all
# projects). Prefer adding it in Mission Control → Connections (encrypted vault).
# Scope/rotate like an admin credential. Default empty.
SUPABASE_ACCESS_TOKEN=

# --- Runtime capabilities ---
# BROWSER_AUTOMATION_ENABLED — supervised browser sessions (approval required).
# Requires: pip install playwright && playwright install chromium
BROWSER_AUTOMATION_ENABLED=false
BROWSER_PROVIDER=playwright
BROWSER_HEADLESS=false
# Phase 9.8B — governed browser evidence artifacts (screenshots, metadata, audit)
BROWSER_ARTIFACTS_DIR=data/browser_artifacts
BROWSER_PROFILES_DIR=data/browser_profiles
BROWSER_CAPTURE_APPROVAL_REQUIRED=false
HOST_EXECUTOR_ENABLED=false

# --- Local workspace intelligence (Phase 9.8C) ---
# Readonly repo registry + engineering artifacts (no unrestricted shell).
LOCAL_WORKSPACE_REGISTRY_DIR=data/local_workspace
LOCAL_WORKSPACE_ARTIFACTS_DIR=data/local_workspace_artifacts
AETHOS_WORKSPACE_ROOT=
AETHOS_PORTFOLIO_ROOT=
DEPLOYMENT_TARGETS_REGISTRY_DIR=data/deployment_targets
AGENT_ARTIFACTS_DIR=data/agent_artifacts

# --- Web Research / Search (Phase 9.8E.6) ---
# Enable governed live web search + website inspection artifacts.
WEB_RESEARCH_ENABLED=false
# Supported providers: none, tavily
WEB_SEARCH_PROVIDER=none
# Tavily API keys usually start with tvly-
WEB_SEARCH_API_KEY=
WEB_RESEARCH_MAX_RESULTS=5
RESEARCH_ARTIFACTS_DIR=data/research_artifacts
# Public CDN/base URL for comparison HTML (optional). Example: https://cdn.example.com
COMPARISON_HTML_PUBLIC_BASE_URL=
# Mirror comparison pages to web/public/comparisons for Next static hosting (optional)
COMPARISON_HTML_MIRROR_WEB_PUBLIC=false

WEB_USER_ID=web_local
WEB_API_TOKEN=

# --- Tracked job worker ---
JOB_MAX_RUNTIME_SEC=300
JOB_PROVIDER_TIMEOUT_SEC=90

# --- Telegram channel (Phase 9.3E) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# --- Telegram UX (Phase 9.8E.6.3) ---
TELEGRAM_TYPING_ENABLED=true
TELEGRAM_TYPING_INTERVAL_SECONDS=4
TELEGRAM_PROGRESS_MESSAGE_ENABLED=true
TELEGRAM_PROGRESS_AFTER_SECONDS=8

# --- Trigger.dev durable jobs (Phase 11.7.9) ---
TRIGGER_ENABLED=false
TRIGGER_API_KEY=
TRIGGER_PROJECT_ID=
TRIGGER_ENV=dev
TRIGGER_WEBHOOK_SECRET=
TRIGGER_DEFAULT_TIMEOUT_SECONDS=900
TRIGGER_MAX_RETRIES=3
TRIGGER_RETRY_BACKOFF_SECONDS=15
TRIGGER_STALE_CALLBACK_MINUTES=10
TRIGGER_ORPHANED_JOB_MINUTES=30

# --- Telegram tunnel (Phase 9.8E.5) — disabled by default ---
TELEGRAM_TUNNEL_ENABLED=false
TUNNEL_PROVIDER=ngrok
NGROK_AUTHTOKEN=
NGROK_REGION=us
NGROK_TARGET_PORT=8010
NGROK_DOMAIN=

# --- Railway greenfield execution enablement (FIX 102) ---
# Modes: disabled | dry_run | enabled (default: disabled)
RAILWAY_GREENFIELD_EXECUTION_ENABLED=false
RAILWAY_GREENFIELD_EXECUTION_MODE=disabled
RAILWAY_GREENFIELD_ALLOWED_PROJECTS=
RAILWAY_GREENFIELD_ALLOWED_ENVIRONMENTS=staging,development
RAILWAY_GREENFIELD_ALLOW_PRODUCTION=false
RAILWAY_GREENFIELD_ALLOWED_SERVICES=
RAILWAY_GREENFIELD_REQUIRE_FINAL_PHRASE=true

# --- Solo local developer fast path (off by default; enable in local .env only) ---
# These are approval-BYPASS flags. Leave them false for a trustworthy, governed
# setup: "fully functional" = every capability available AND every consequential
# action still routed through Mission Control approval. Turning these on removes
# that gate (autonomous / auto-approved execution).
AETHOS_SOLO_EXECUTION_MODE=false
AETHOS_SOLO_EXECUTION_PROVIDER=railway
AETHOS_SOLO_ALLOWED_REPOS=
AETHOS_SOLO_ALLOWED_PROVIDERS=railway,vercel
AETHOS_SOLO_ALLOWED_ENVIRONMENTS=staging,development,production
AETHOS_SOLO_ALLOW_PRODUCTION=false
AETHOS_SOLO_REQUIRE_FINAL_CONFIRMATION=true
AETHOS_SOLO_AUTO_APPROVE=false
AETHOS_SOLO_AUTO_APPROVE_PHASES=false
AETHOS_LOCAL_ENV_TRUSTED=false
AUTONOMOUS_EXECUTION_ENABLED=false
CREDENTIAL_LIVE_VALIDATION_ENABLED=true
PRESENTATION_BYPASS_CHAT_ENABLED=false
PRESENTATION_BYPASS_MC_ENABLED=true
AWS_READONLY_INVENTORY_ENABLED=false
CLOUD_READONLY_INVENTORY_ENABLED=false
KUBERNETES_VAULT_KUBECONFIG_ENABLED=false
CLOUDFLARE_API_TOKEN=

# Doctor profiles: development | staging | production | strict | relaxed (empty = infer from OPERATIONAL_ENVIRONMENT)
AETHOS_DOCTOR_PROFILE=
# Acknowledge intentional break-glass flags (HOST_EXECUTOR, production mutations) in dev/staging doctor
AETHOS_OPERATOR_BREAK_GLASS_ACKNOWLEDGED=false

# --- Workspace root (local repo path for greenfield deploy) ---
# AETHOS_WORKSPACE_ROOT=/path/to/AethOS

# --- Governed mutations ---
MUTATION_EXECUTION_ENABLED=false
MUTATION_T3_PRODUCTION_ENABLED=false
PROVIDER_ENV_VAR_MUTATIONS_ENABLED=true
PROVIDER_E2E_ORCHESTRATION_ENABLED=true

# --- Unified agentic-OS surfaces (AETHOS_OPERATOR_HANDOFF §3) ---
# All network-facing / mutating surfaces default OFF; enable per capability.
# VECTOR_MEMORY_ENABLED and WEB_RESEARCH_ENABLED are defined elsewhere in this file.
WORKSPACE_SUITE_ENABLED=false         # research/compare/docs/notes/calendar/email tabs
WORKSPACE_SUITE_STORE_DIR=data/workspace_suite  # gitignored draft store (documents/notes/...)
CHANNEL_GATEWAY_ENABLED=false         # multi-channel inbound/outbound
CHANNEL_DM_POLICY=pairing             # pairing | open (keep 'pairing' for safety)
CHANNEL_PAIRING_STORE_DIR=data/channel_pairing  # gitignored sender allowlist/pairing store
CHANNEL_OUTBOUND_STORE_DIR=data/channel_outbound  # gitignored outbound-send preflight store
OUTBOUND_SEND_EXECUTION_ENABLED=false # gate the actual outbound send on approval (keep off)
VOICE_SURFACE_ENABLED=false           # master switch: voice & audio surface (talk to AethOS, hear replies)
VOICE_INPUT_ENABLED=false             # mic capture + speech-to-text
VOICE_OUTPUT_ENABLED=false            # spoken replies (text-to-speech)
VOICE_WAKE_ENABLED=false              # hands-free talk mode + wake phrase
VOICE_STT_PROVIDER=browser            # browser (Web Speech API) | whisper (OpenAI Whisper, server-side)
VOICE_TTS_PROVIDER=system             # system (browser voices) | elevenlabs (premium, needs key)
ELEVENLABS_API_KEY=                    # only if VOICE_TTS_PROVIDER=elevenlabs; read server-side only
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
VOICE_WAKE_PHRASE=hey aethos          # spoken trigger for hands-free talk mode
CANVAS_SURFACE_ENABLED=false          # Live Canvas visual workspace (read-only render surface)
CANVAS_STORE_DIR=data/canvas          # gitignored Live Canvas render store
SKILLS_REGISTRY_ENABLED=false         # evolving skills
SANDBOX_NONMAIN_ENABLED=true          # sandbox non-main sessions (keep ON)
MODEL_FOUNDRY_ENABLED=false           # local model discovery/serve
# Model Foundry convenience automation (opt-in; default OFF — approval is the consent gate).
MODEL_FOUNDRY_AUTOSTART_ENABLED=false      # on approve, start a loopback Ollama runtime if none is responding
MODEL_FOUNDRY_AUTODOWNLOAD_ENABLED=false   # on approve, pull the approved model if not present
LOCAL_TOOL_LOOP_ENABLED=true               # run the agent tool loop on the selected local model (OpenAI-compatible tools) instead of silently swapping to a cloud model
MULTI_PROVIDER_TOOL_LOOP_ENABLED=true      # run the agent tool loop on the selected provider (OpenRouter/OpenAI-compatible) instead of swapping to Anthropic
MODEL_FAILOVER_MAX_ATTEMPTS=3              # cap cross-provider failover attempts per turn so an outage can't cascade across paid models

# FIX 117 — production policy hardening (policy only; forward live prod locked by default)
RAILWAY_PRODUCTION_INCIDENT_MODE=false
RAILWAY_PRODUCTION_DEPLOYMENT_FREEZE=false
RAILWAY_PRODUCTION_FREEZE_START_UTC=
RAILWAY_PRODUCTION_FREEZE_END_UTC=
RAILWAY_PRODUCTION_SHADOW_MODE_REQUIRED=true
RAILWAY_PRODUCTION_FORWARD_LIVE_UNLOCKED=false
RAILWAY_PRODUCTION_OPERATOR_QUORUM=2
RAILWAY_PRODUCTION_REQUIRE_SECOND_CONFIRMATION=true
RAILWAY_PRODUCTION_AUDIT_RETENTION_DAYS=90
RAILWAY_PRODUCTION_SLO_VERIFICATION_REQUIRED=true
RAILWAY_PRODUCTION_SHADOW_EXECUTION=false
RAILWAY_PRODUCTION_VERIFICATION_MIN_STRONG_SIGNALS=2
RAILWAY_PRODUCTION_VERIFICATION_MIN_SIGNAL_FAMILIES=3
RAILWAY_PRODUCTION_VERIFICATION_REJECT_WEAK_ONLY=true
RAILWAY_PRODUCTION_VERIFICATION_REQUIRE_LOG_EVIDENCE=true
RAILWAY_PRODUCTION_ROLLBACK_ESCALATION_ENABLED=true
RAILWAY_PRODUCTION_ROLLBACK_REHEARSAL_QUORUM=2
RAILWAY_PRODUCTION_ROLLBACK_REQUIRE_INCIDENT_COMMANDER_ACK=true
RAILWAY_PRODUCTION_ROLLOUT_ORCHESTRATION_ENABLED=true
RAILWAY_PRODUCTION_ROLLOUT_REQUIRE_VERIFICATION=true
RAILWAY_PRODUCTION_ROLLOUT_REQUIRE_ESCALATION_CLEAR=true
RAILWAY_PRODUCTION_CANARY_SHADOW_POLICY_ENABLED=true
RAILWAY_PRODUCTION_MAX_CANARY_PERCENT=5
RAILWAY_PRODUCTION_CANARY_PROMOTION_PAUSE_ERROR_RATE=0.05
RAILWAY_PRODUCTION_REQUIRE_SYNTHETIC_VERIFICATION_TRAFFIC=true
RAILWAY_PRODUCTION_SHADOW_TRAFFIC_MIRROR_SIMULATION=true
RAILWAY_PRODUCTION_INCIDENT_COMMAND_ENABLED=true
RAILWAY_PRODUCTION_INCIDENT_DEFAULT_SEVERITY=sev2
SOFTWARE_DELIVERY_ISSUE_PLAN_ENABLED=true
SOFTWARE_DELIVERY_REQUIRE_PLANNING_APPROVAL=true
# FIX 125B — governed branch orchestration (workspace layer; no code/PR/merge)
SOFTWARE_DELIVERY_BRANCH_ORCHESTRATION_ENABLED=true
SOFTWARE_DELIVERY_BRANCH_REQUIRE_PLANNING_APPROVED=true
# FIX 125C — patch proposal + diff preview (no file writes until future step)
SOFTWARE_DELIVERY_PATCH_PROPOSAL_ENABLED=true
SOFTWARE_DELIVERY_PATCH_REQUIRE_PLANNING_APPROVED=true
SOFTWARE_DELIVERY_PATCH_REQUIRE_ACTIVE_BRANCH=true
# FIX 125D — apply approved patch to governed workspace only (no git/PR/deploy)
SOFTWARE_DELIVERY_WORKSPACE_APPLY_ENABLED=true
SOFTWARE_DELIVERY_WORKSPACE_REQUIRE_PATCH_APPROVED=true
# FIX 125E — verify governed workspace (no repo/git/PR/deploy; allowlisted test off by default)
SOFTWARE_DELIVERY_WORKSPACE_VERIFICATION_ENABLED=true
SOFTWARE_DELIVERY_WORKSPACE_VERIFICATION_REQUIRE_APPLIED=true
SOFTWARE_DELIVERY_WORKSPACE_ALLOW_ALLOWLISTED_TEST=false
# FIX 125F — PR draft artifact (no GitHub PR / git push / merge / deploy)
SOFTWARE_DELIVERY_PR_DRAFT_ENABLED=true
SOFTWARE_DELIVERY_PR_DRAFT_REQUIRE_VERIFICATION=true
# FIX 125G — GitHub PR creation preflight (no push/PR; approve gates 125H/125I)
SOFTWARE_DELIVERY_GITHUB_PR_PREFLIGHT_ENABLED=true
SOFTWARE_DELIVERY_GITHUB_PR_PREFLIGHT_REQUIRE_DRAFT=true
# FIX 125H — push workspace to GitHub feature branch only (no PR/merge/deploy/main)
SOFTWARE_DELIVERY_GITHUB_BRANCH_PUSH_ENABLED=true
SOFTWARE_DELIVERY_GITHUB_DEFAULT_BRANCH=main
# FIX 125I — open GitHub PR after 125H push (human review; no merge/deploy/Railway)
SOFTWARE_DELIVERY_GITHUB_PR_OPEN_ENABLED=true
# FIX 126 — Phase 2 software delivery loop frozen (125A–125I complete; 125J/127 deferred)
SOFTWARE_DELIVERY_PHASE_2_FROZEN=true
# FIX 127 — bounded advisory agent roles (no merge/deploy/Railway/mutation)
SOFTWARE_DELIVERY_MULTI_AGENT_ENABLED=true
# FIX 128 — Mission Control cross-lane observability (read-only; no mutation)
MISSION_CONTROL_CROSS_LANE_ENABLED=true

# --- Production deployment (Phase 9.9) ---
# Modes: local, team, enterprise, edge, hosted
DEPLOYMENT_MODE=local
# embedded = workers in API process; standalone = separate worker container
WORKER_MODE=embedded
EDGE_RUNTIME_ENABLED=false
HOSTED_CLOUD_ENABLED=false

# --- Operational environment label (development | staging | production | local) ---
# Overrides APP_ENV/DEPLOYMENT_MODE for operator banners and mutation scope when set.
OPERATIONAL_ENVIRONMENT=

# --- Operator platform: channels ---
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Email (SMTP or SendGrid)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
# Public web URL for signup verification links (include path prefix, e.g. https://aethos.example.com/aethos)
PUBLIC_APP_BASE_URL=
SENDGRID_API_KEY=

# SMS / Voice (Twilio)
SMS_ENABLED=false
VOICE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=

# Microsoft Teams (incoming webhook for outbound replies)
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=

# --- Operator platform: execution plane + tools ---
AUTONOMOUS_EXECUTION_PLANE_ENABLED=false
MCP_BRIDGE_ENABLED=false
VECTOR_MEMORY_ENABLED=false
VECTOR_MEMORY_BACKEND=local
CHROMADB_HOST=localhost
CHROMADB_PORT=8100
VECTOR_MEMORY_EMBEDDING_PROVIDER=local
VECTOR_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
CRON_GOVERNED_JOBS_ENABLED=false
# User-defined scheduled tasks + inbound webhook triggers (governed delivery).
PROACTIVE_AUTOMATION_ENABLED=false
# PWA web push — proactive automations reach the operator when the tab is closed.
# Generate keys: python scripts/generate_vapid_keys.py
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@aethos.local
LLM_PROVIDER_ROUTING_ENABLED=true
# OpenRouter credentials live in the "AI model providers" section at the top.

# GitHub workflow dispatch skill
GITHUB_WORKFLOW_DISPATCH_ENABLED=false

# Vercel greenfield (net-new project + link repo + deploy)
VERCEL_GREENFIELD_EXECUTION_ENABLED=false
VERCEL_GREENFIELD_CREATE_PROJECT_ENABLED=true
VERCEL_TEAM_ID=

# AethOS onboarding & login (Stage 3)
# Onboarding is local-only personalization (first-run rapport profile) — safe on.
AETHOS_ONBOARDING_ENABLED=true
# Login gate is network-facing; default off. Set a passphrase to require sign-in.
AETHOS_LOGIN_ENABLED=false
AETHOS_LOGIN_PASSPHRASE=
# Where the operator persona profile is stored (local JSON only).
OPERATOR_PERSONA_STORE_DIR=data/operator_persona

# AethOS provisioning orchestration (Stage 4) — governed multi-step deploy +
# third-party connect (Stripe/Supabase/Resend/Redis). Network-facing; default off.
PROVISIONING_ORCHESTRATION_ENABLED=false

# §2 Enterprise authentication — server-side sessions + SSO (OIDC) + MFA (TOTP).
# AUTH_ENABLED gates middleware enforcement on protected /api/v1 routes. Default
# OFF so single-operator local deploys are unchanged; turn ON for shared deploys.
# Session signing key + TOTP secrets are stored under AUTH_STORE_DIR (0600), not here.
AUTH_ENABLED=false
AUTH_STORE_DIR=data/auth
AUTH_SESSION_COOKIE=aethos_session
AUTH_SESSION_IDLE_TIMEOUT_SEC=1800
AUTH_SESSION_ABSOLUTE_TIMEOUT_SEC=43200
AUTH_COOKIE_SECURE=true                 # set false ONLY for plain-http localhost
# Local UI (:3000) → API (:8010) needs explicit CORS origins for session cookies (auto in dev).
# CORS_ALLOWED_ORIGINS=https://your-ui.example.com
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SEC=900
# SSO via OIDC (Okta / Microsoft Entra / Google Workspace) — authorization-code + PKCE.
SSO_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid email profile
OIDC_ALLOWED_DOMAINS=                   # comma-separated; empty = any verified email
# MFA / TOTP for local accounts (RFC 6238).
MFA_ENABLED=false
MFA_REQUIRED=false
MFA_ISSUER_LABEL=AethOS
# Self-service signup for local email+password accounts. OFF by default (no open
# signup on a single-operator deploy). Turn ON for an email+password beta so each
# user creates their own account from the UI. New accounts get the "operator"
# role only — never admin/approver.
AUTH_SELF_SIGNUP_ENABLED=false

# Multi-tenancy (operator-only — see MULTI_TENANT_PLAN.md). OFF by default ⇒
# byte-for-byte single-tenant behavior. When ON, auth is REQUIRED (sessions are
# enforced even if AUTH_ENABLED is left off — fail closed), every request resolves
# a per-user tenant, and detached work (durable jobs, arbiter sessions) is stamped
# with the owning tenant at creation. Do NOT enable on a public/shared URL until
# the Correction 5 two-tenant isolation tests + security review are green.
MULTI_TENANT_ENABLED=false
# Per-tenant abuse ceiling (Correction 4): max arbiter runs/hour per non-operator
# tenant when MULTI_TENANT_ENABLED (the arbiter fans out to many models per turn,
# so this caps a single tenant's cost on the operator-paid instance). Operator
# (default tenant) is exempt; 0 disables. Per-request throttling is already
# per-session via the §4 HTTP rate limiter.
TENANT_ARBITER_RUNS_PER_HOUR=60
# Per-tenant daily LLM token ceiling (input+output). 0 = unlimited. Non-operator
# tenants only when MULTI_TENANT_ENABLED.
TENANT_LLM_TOKENS_PER_DAY=0

# §3 Unified tamper-evident audit ledger — append-only hash-chained log of
# privileged actions (export via /observability/audit/export for SIEM ingestion).
AUDIT_LEDGER_ENABLED=true
AUDIT_LEDGER_DIR=data/audit

# §4 API rate limiting & abuse protection — per-identity + per-IP sliding-window
# limits + request body size cap. On by default (loopback exempt for local use).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_DEFAULT_PER_MIN=240
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_MUTATION_PER_MIN=30
RATE_LIMIT_CHAT_PER_MIN=90
RATE_LIMIT_EXEMPT_LOOPBACK=true
MAX_REQUEST_BYTES=10485760

# §5 Transport security headers — CSP / HSTS / nosniff / frame-deny / referrer /
# permissions-policy on every API response. HSTS requires a TLS-terminating
# reverse proxy for non-localhost deploys (it is ignored over plain http).
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_HSTS_ENABLED=true
SECURITY_HEADERS_HSTS_MAX_AGE=63072000

# §8 Observability export — OpenTelemetry + structured logs + error sink + SLOs.
# OTel/Sentry only activate when their libs are installed AND enabled here.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aethos
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=text                  # text | json (structured, secret-redacted)
ERROR_TRACKING_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SLO_CHAT_LATENCY_MS=8000
SLO_MUTATION_SUCCESS_RATE=0.95

# §9 External KMS / secret-manager option — envelope-encrypt the vault DEK with an
# external KEK. Default "" keeps the local encrypted-file vault. Set one backend.
KMS_BACKEND=                     # "" (local) | aws | gcp | vault
AWS_KMS_KEY_ID=
AWS_REGION=
GCP_KMS_KEY_NAME=                # projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>
VAULT_KMS_ADDR=
VAULT_KMS_TOKEN=  # gitleaks:allow - empty documented setting
VAULT_KMS_TRANSIT_KEY=aethos

# §10 Data governance — retention (opt-in per category; 0 = keep forever), PII
# redaction in logs, and backup location. Audit retention archives (never deletes).
RETENTION_ENABLED=false
RETENTION_CHAT_DAYS=0
RETENTION_JOBS_DAYS=0
RETENTION_ARTIFACTS_DAYS=0
RETENTION_AUDIT_DAYS=0
PII_REDACTION_ENABLED=true
BACKUP_DIR=data/backups

# GCP / Azure readonly inventory (optional CLIs + credentials)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Multi-model Arbiter (optional — off by default)
# Dispatches one prompt to N models in parallel, runs a governed peer-critique
# round, and surfaces a consensus result. Requires at least 2 models in the pool
# and the matching provider credentials (ANTHROPIC_API_KEY / OPENROUTER_API_KEY /
# LOCAL_LLM_*). Read-only analysis — mutations remain approval-gated.
# ARBITER_ENABLED=true
# ARBITER_MODEL_POOL=anthropic:claude-opus-4-6,openrouter:openai/gpt-4.1-mini,local:llama3.2
# ARBITER_CONSENSUS_THRESHOLD=0.7
# ARBITER_MAX_ROUNDS=1
# ARBITER_MAX_MODELS=8
# ARBITER_TIMEOUT_SEC=180
# ARBITER_BLIND_CRITIQUE=true
# ARBITER_PERSIST_FULL_RESPONSES=true
