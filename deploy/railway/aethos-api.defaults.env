# Non-secret defaults for Railway service: aethos-api (staging/production).
# Apply: railway link -p pilotos -e staging -s aethos-api
#        railway variables --set "$(grep -v '^#' deploy/railway/aethos-api.defaults.env | xargs)"
# Add secrets (API keys) in Railway UI or: railway variables set ANTHROPIC_API_KEY=...

APP_ENV=staging
DEPLOYMENT_MODE=hosted
API_PORT=8010
USE_REAL_LLM=true
ACTIVE_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_RUNTIME_ENABLED=true
DURABLE_AGENT_JOBS_ENABLED=true
LIVE_PROGRESS_ENABLED=true
PROMPT_CACHE_ENABLED=true
CONVERSATION_MEMORY_ENABLED=true
CHAT_SINGLE_LOOP_ENABLED=true
DEEP_RESEARCH_ENABLED=false
AUDIT_LEDGER_ENABLED=true
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_HSTS_ENABLED=true
PII_REDACTION_ENABLED=true
LOG_FORMAT=json
MULTI_TENANT_ENABLED=true
AUTH_ENABLED=true
AUTH_SELF_SIGNUP_ENABLED=true
AUTH_COOKIE_SECURE=true
TENANT_ARBITER_RUNS_PER_HOUR=60
TENANT_LLM_TOKENS_PER_DAY=0
ARBITER_ENABLED=true
WORKSPACE_SUITE_ENABLED=true
MCP_BRIDGE_ENABLED=true
PROACTIVE_AUTOMATION_ENABLED=false
WEB_PUSH_ENABLED=false
VOICE_SURFACE_ENABLED=false
VOICE_INPUT_ENABLED=false
VOICE_OUTPUT_ENABLED=false
CRON_GOVERNED_JOBS_ENABLED=false
WEB_RESEARCH_ENABLED=false
BROWSER_AUTOMATION_ENABLED=false
TRIGGER_ENABLED=false
AUTONOMOUS_EXECUTION_PLANE_ENABLED=false
CANVAS_SURFACE_ENABLED=true
